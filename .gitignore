# Binarios de herramientas: se descargan con setup.ps1, no se versionan (14 MB)
tools/

# Documentación oficial de Roblox clonada como referencia local (19 MB).
# Se recupera con setup.ps1; ver README.
creator-docs/

# Artefactos generados
sourcemap.json
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
*.rbxm
*.rbxmx

# EXCEPCIÓN: los assets que son PARTE del juego, no artefactos de compilación.
# La regla de arriba existe para no versionar lo que genera Rojo; ésta es al revés
# -- el mapa sobre el que se juega, que no puede vivir como un id en el código
# porque InsertService:LoadAsset no carga assets de otra cuenta (probado: "User is
# not authorized to access Asset"). Sin esta línea, clonar el repo da un juego sin
# ciudad. Ver games/contrabando/src/assets/LEEME.md.
!games/*/src/assets/*.rbxm
!games/*/src/assets/*.rbxmx
!games/*/mapa/*.rbxm
!games/*/mapa/*.rbxmx

# Secretos (por si algún día usamos backend propio)
.env
.env.*
!.env.example
